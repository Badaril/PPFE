%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 640d6c9f4a94f5040b03192faa9f3a7b, type: 3}
  m_Name: TutoData
  m_EditorClassIdentifier: Assembly-CSharp::HUDTextDatas
  textRow:
  - index: 0
    text: Bonjour. Appuyez sur le bouton rouge pour continuer.
    nextRowIndex: 1
    conditionEnabled: 0
    IsFinished: 0
  - index: 1
    text: "Bienvenue dans cette exp\xE9rience VR : Naturalis. Appuyez sur le bouton
      rouge pour continuer."
    nextRowIndex: 2
    conditionEnabled: 0
    IsFinished: 0
  - index: 2
    text: Vous incarnez un naturaliste qui doit remplir son carnet d'observation
      en collant les photos d'animaux qu'il prend.
    nextRowIndex: 3
    conditionEnabled: 0
    IsFinished: 0
  - index: 3
    text: "Pour commencer, vous pouvez attraper les objets autour de vous. Pour cela,
      pointez votre laser vers l'objet et appuyez sur la gachette int\xE9rieure de
      votre manette."
    nextRowIndex: 4
    conditionEnabled: 0
    IsFinished: 0
  - index: 4
    text: "Super. Ici, le talkie-walkie permet de localiser les animaux gr\xE2ce
      \xE0 leur son. Posez le talkie-walkie pour continuer."
    nextRowIndex: 5
    conditionEnabled: 0
    IsFinished: 0
  - index: 5
    text: Maintenant, prenez l'appareil photo en main. Vous pouvez zoomer ou dezoomer
      en poussant ou tirant le joystick de votre manette.
    nextRowIndex: 6
    conditionEnabled: 0
    IsFinished: 0
  - index: 6
    text: "Super. Pour prendre une photo, appuyer sur les boutons ou sur la gachette
      ext\xE9rieure de votre manette."
    nextRowIndex: 7
    conditionEnabled: 1
    IsFinished: 0
  - index: 7
    text: "Ensuite, vous pouvez coller la photo dans le carnet. Pour cela, prenez
      la photo en main, puis l\xE2cher la en appuyant de nouveau sur la gachette
      int\xE9rieur au dessus du cadre noir."
    nextRowIndex: 8
    conditionEnabled: 0
    IsFinished: 0
  - index: 8
    text: "Enfin, prenez la page de droite, tournez la feuille vers la gauche et
      l\xE2chez la."
    nextRowIndex: 9
    conditionEnabled: 0
    IsFinished: 0
  - index: 9
    text: "Parfait, vous avez les bases. Vous pouvez vous entra\xEEner avec cet escargot.
      Quand vous vous sentez pr\xEAt, appuyez sur le bouton rouge pour commencer
      l'exp\xE9rience."
    nextRowIndex: 10
    conditionEnabled: 0
    IsFinished: 0
  - index: 10
    text: 
    nextRowIndex: -1
    conditionEnabled: 0
    IsFinished: 1
