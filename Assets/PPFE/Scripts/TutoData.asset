%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 640d6c9f4a94f5040b03192faa9f3a7b, type: 3}
  m_Name: TutoData
  m_EditorClassIdentifier: Assembly-CSharp::HUDTextDatas
  textRow:
  - index: 0
    text: "Ce bouton rouge vous aidera \xE0 avancer dans le tutoriel. Appuyez dessus
      avec votre manette pour continuer."
    nextRowIndex: 1
    conditionEnabled: 0
    nextRowIndexByCondition: -1
    IsFinished: 0
  - index: 1
    text: "Bienvenue dans cette exp\xE9rience VR dans laquelle vous incarnez un naturaliste."
    nextRowIndex: 2
    conditionEnabled: 0
    nextRowIndexByCondition: -1
    IsFinished: 0
  - index: 2
    text: Votre objectif est de remplir votre carnet d'observation en collant des
      photos d'animaux.
    nextRowIndex: 3
    conditionEnabled: 0
    nextRowIndexByCondition: -1
    IsFinished: 0
  - index: 3
    text: Pour commencer, vous pouvez attraper les objets autour de vous.
    nextRowIndex: 4
    conditionEnabled: 1
    nextRowIndexByCondition: 14
    IsFinished: 0
  - index: 4
    text: "Pour cela, pointez votre laser vers l'objet et appuyez sur la gachette
      int\xE9rieure de votre manette."
    nextRowIndex: 5
    conditionEnabled: 0
    nextRowIndexByCondition: -1
    IsFinished: 0
  - index: 5
    text: "Super. Ici, le talkie-walkie permet de localiser les animaux gr\xE2ce
      \xE0 leur son."
    nextRowIndex: 6
    conditionEnabled: 1
    nextRowIndexByCondition: 15
    IsFinished: 0
  - index: 6
    text: "Vous pouvez \xE9galement poser les objets en appuyant de nouveau sur la
      m\xEAme gachette."
    nextRowIndex: 7
    conditionEnabled: 0
    nextRowIndexByCondition: -1
    IsFinished: 0
  - index: 7
    text: Maintenant, prenez l'appareil photo en main.
    nextRowIndex: 8
    conditionEnabled: 0
    nextRowIndexByCondition: -1
    IsFinished: 0
  - index: 8
    text: "En tirant ou en poussant sur le joystick, vous pouvez zoomer ou d\xE9zoomer
      avec l'appareil photo."
    nextRowIndex: 9
    conditionEnabled: 0
    nextRowIndexByCondition: -1
    IsFinished: 0
  - index: 9
    text: "Super. Pour prendre une photo, appuyez sur les boutons ou sur la gachette
      ext\xE9rieure de votre manette."
    nextRowIndex: 10
    conditionEnabled: 0
    nextRowIndexByCondition: -1
    IsFinished: 0
  - index: 10
    text: "Ensuite, vous pouvez coller la photo dans le carnet. Pour cela, prenez
      la photo en main, puis posez la sur le carr\xE9 noir."
    nextRowIndex: 11
    conditionEnabled: 0
    nextRowIndexByCondition: -1
    IsFinished: 0
  - index: 11
    text: "Enfin, attrapez la page de droite, tournez la feuille vers la gauche et
      l\xE2chez la."
    nextRowIndex: 12
    conditionEnabled: 0
    nextRowIndexByCondition: -1
    IsFinished: 0
  - index: 12
    text: "Parfait, vous avez les bases. Vous pouvez vous entra\xEEner avec cet escargot.
      Quand vous vous sentez pr\xEAt, appuyez sur le bouton rouge pour commencer
      l'exp\xE9rience."
    nextRowIndex: 13
    conditionEnabled: 0
    nextRowIndexByCondition: -1
    IsFinished: 0
  - index: 13
    text: 
    nextRowIndex: -1
    conditionEnabled: 0
    nextRowIndexByCondition: -1
    IsFinished: 1
  - index: 14
    text: "Pour cela, pointez votre laser vers l'objet et restez appuy\xE9 sur la
      gachette int\xE9rieure de votre manette."
    nextRowIndex: 5
    conditionEnabled: 0
    nextRowIndexByCondition: -1
    IsFinished: 0
  - index: 15
    text: "Vous pouvez \xE9galement poser les objets en l\xE2chant la m\xEAme gachette."
    nextRowIndex: 7
    conditionEnabled: 0
    nextRowIndexByCondition: -1
    IsFinished: 0
